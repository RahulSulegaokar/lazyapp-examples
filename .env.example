# --- LazyApp -------------------------------------------------------------------
# API key from LazyApp → Settings → API keys. Server: messages:send, messages:read, flows:write,
# payments:write (refunds). `npm run setup` also: templates:read, templates:write, webhooks:write, connections:write.
LAZYAPP_API_KEY=sk_test_replace_me
LAZYAPP_BASE_URL=https://lazyapp.in

# Signing secret printed once by `npm run setup` when it creates the webhook endpoint.
LAZYAPP_WEBHOOK_SECRET=

# Send from this number when the workspace has several (GET /v1/connections → phone_number_id).
LAZYAPP_PHONE_NUMBER_ID=
# Used by `npm run setup` to pick the connection; defaults to the workspace default.
LAZYAPP_CONNECTION_UUID=

# Per-flow data-endpoint secrets (LazyApp → Flows → the flow → data endpoint), as JSON
# keyed "<exampleId>/<flowKey>". The API does not expose them yet.
LAZYAPP_FLOW_SECRETS={}

# --- Demo server ----------------------------------------------------------------
# Public HTTPS origin LazyApp reaches (webhooks and flow data endpoints hang off it).
PUBLIC_BASE_URL=https://demo.lazyapp.in
# The demo number in E.164, for the chat links on GET /demos.
DEMO_PHONE_NUMBER=
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/demo.sqlite
LOG_LEVEL=info

# Comma-separated example ids to run, in hub order (default: every example).
DEMO_EXAMPLES=
# Also run examples/_template ("DEMO HELLO").
INCLUDE_REFERENCE_EXAMPLE=false
SESSION_IDLE_HOURS=24

# --- Optional capabilities --------------------------------------------------------
# Active WhatsApp payment configuration name (India). Auto-detected when empty.
PAYMENT_CONFIGURATION=
# Cashfree/Razorpay gateway account id in LazyApp, for payment-link fallback.
PAYMENT_GATEWAY_ACCOUNT=

# Local development only.
ALLOW_UNSIGNED_FLOW_REQUESTS=false
ALLOW_DRAFT_FLOWS=false

# --- Example settings ----------------------------------------------------------------
# otp-login: one-tap autofill for an Android app (both required; see examples/otp-login).
OTP_LOGIN_ANDROID_PACKAGE=
OTP_LOGIN_ANDROID_SIGNATURE_HASH=
# event-tickets: PIN door staff enter on the check-in page (the demo shows it in the chat).
EVENT_TICKETS_STAFF_PIN=2468

# --- Example: real-estate (DEMO HOMES) --------------------------------------------
# Number on the agent contact card (defaults to DEMO_PHONE_NUMBER, so "Message" opens this chat).
REAL_ESTATE_AGENT_PHONE=
# demo: reminder 2 min and feedback 7 min after booking. production: 3 h before / 2 h after the visit.
REAL_ESTATE_REMINDERS=demo
# true: confirm visits through POST /v1/events (needs an appointment.* event mapping).
REAL_ESTATE_USE_EVENTS=false

# --- Example: lead-generation (DEMO LEADS) ------------------------------------------
# CRM endpoint for lead events (signed with the secret). Unset: leads stay in the demo database.
LEADS_CRM_WEBHOOK_URL=
LEADS_CRM_WEBHOOK_SECRET=
# demo: reminder +2 min, nurture +3/+10 min. production: 15 min before, +2/+5 days.
LEADS_TIMING=demo
LEADS_USE_EVENTS=false
LEADS_REP_PHONE=

# --- Example: platform-saas (DEMO PLATFORM) -------------------------------------------
# SalonBook's own key, separate from LAZYAPP_API_KEY: an sk_test_ key on a platform-enabled workspace
# (customers:write, templates:write, webhooks:write). Unset: the SalonBook page explains what to set.
PLATFORM_SAAS_API_KEY=
# Live keys are refused unless this is true (the demo creates and deletes customers daily).
PLATFORM_SAAS_ALLOW_LIVE=false
# Printed by `npm run provision-webhook -w @lazyapp-examples/example-platform-saas`.
PLATFORM_SAAS_WEBHOOK_SECRET=
# Optional https scheduling page for "Book a call". Unset: the chat asks for a preferred time.
PLATFORM_SAAS_BOOK_CALL_URL=
# Automation pack the "Provision" button installs for a salon (LazyApp ships real_estate today).
PLATFORM_SAAS_AUTOMATION_PACK=real_estate
