# --- LazyApp -------------------------------------------------------------------
# API key from LazyApp → Settings → API keys. Scopes: messages:send, messages:read,
# templates:write, connections:write, payments:write (payments examples only).
LAZYAPP_API_KEY=sk_test_replace_me
LAZYAPP_BASE_URL=https://lazyapp.in

# Signing secret printed once by `npm run setup` when it creates the webhook endpoint.
LAZYAPP_WEBHOOK_SECRET=

# Send from this number when the workspace has several (GET /v1/connections → phone_number_id).
LAZYAPP_PHONE_NUMBER_ID=
# Used by `npm run setup` to pick the connection; defaults to the workspace default.
LAZYAPP_CONNECTION_UUID=

# Per-flow data-endpoint secrets (LazyApp → Flows → the flow → data endpoint), as JSON
# keyed "<exampleId>/<flowKey>". The API does not expose them yet.
LAZYAPP_FLOW_SECRETS={}

# --- Demo server ----------------------------------------------------------------
# Public HTTPS origin LazyApp reaches (webhooks and flow data endpoints hang off it).
PUBLIC_BASE_URL=https://demo.lazyapp.in
# The demo number in E.164, for the chat links on GET /demos.
DEMO_PHONE_NUMBER=
HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/demo.sqlite
LOG_LEVEL=info

# Comma-separated example ids to run, in hub order (default: every example).
DEMO_EXAMPLES=
# Also run examples/_template ("DEMO HELLO").
INCLUDE_REFERENCE_EXAMPLE=false
SESSION_IDLE_HOURS=24

# --- Optional capabilities --------------------------------------------------------
# Active WhatsApp payment configuration name (India). Auto-detected when empty.
PAYMENT_CONFIGURATION=
# Cashfree/Razorpay gateway account id in LazyApp, for payment-link fallback.
PAYMENT_GATEWAY_ACCOUNT=

# Local development only.
ALLOW_UNSIGNED_FLOW_REQUESTS=false
ALLOW_DRAFT_FLOWS=false

# --- Example settings ----------------------------------------------------------------
# otp-login: one-tap autofill for an Android app (both required; see examples/otp-login).
OTP_LOGIN_ANDROID_PACKAGE=
OTP_LOGIN_ANDROID_SIGNATURE_HASH=
# event-tickets: PIN door staff enter on the check-in page (the demo shows it in the chat).
EVENT_TICKETS_STAFF_PIN=2468
